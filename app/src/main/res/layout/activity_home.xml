<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ActivityHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ActivityHome"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#030711"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/logorunningapp" />

            <TextView
                android:id="@+id/textView13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/inter_tight_semibold"
                android:paddingLeft="12dp"
                android:text="Running App"
                android:textColor="#FAFAFA"
                android:textSize="28sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/textView15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_tight"
                android:text="Hola, "
                android:textColor="#EBEBEB"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/textViewTituloNombreHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_tight"
                android:text="Nombre"
                android:textColor="#EBEBEB"
                android:textSize="22sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/linearLayoutGestionarUsuarioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    app:contentPadding="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageViewGestionarUsuarios"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/group"/>
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewGestionarUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Gestionar \nusuarios"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutResultadosPersonalesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    android:orientation="vertical"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:contentPadding="10dp">

                    <ImageView
                        android:id="@+id/imageViewResultadosPersonales"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/doc5"
                        app:cardCornerRadius="16dp" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewResultadosPersonales"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Resultados \npersonales"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_margin="3dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    app:contentPadding="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageViewEntrenamientos"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/dumbbell"
                        app:cardCornerRadius="16dp" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewEntrenamientos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Entrenamientos"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_margin="3dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    app:contentPadding="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageViewAlimentacion"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/eat4"
                        app:cardCornerRadius="16dp" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewAlimentacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Alimentación"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/linearLayoutMaratonesEventosButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    app:contentPadding="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageViewAdd1"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/finish2"
                        app:cardCornerRadius="16dp" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewAdd1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Maratones\ny Eventos"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutClimaButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    android:orientation="vertical"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:contentPadding="10dp">

                    <ImageView
                        android:id="@+id/imageViewAdd3"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/clima"
                        app:cardCornerRadius="16dp" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewAdd3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Clima\n"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_margin="3dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    app:contentPadding="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageViewAdd2"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/store2"
                        app:cardCornerRadius="16dp" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewAdd2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Tienda\ndeportiva"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:visibility="invisible">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:backgroundTint="#1d283a"
                    app:contentPadding="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageViewAdd4"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:src="@drawable/store2"
                        app:cardCornerRadius="16dp" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/textViewAdd4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_tight"
                    android:text="Tienda\ndeportiva"
                    android:textAlignment="center"
                    android:textColor="#F2F1F1"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:cardCornerRadius="16dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="#1d283a"
            android:layout_marginTop="20dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView19"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/inter_tight_semibold"
                    android:text="Últimos resultados personales"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewHomeDistancia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_tight_medium"
                            android:text="Distancia"
                            android:textColor="#E2DEDE" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewHomeTiempo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_tight_medium"
                            android:text="Tiempo"
                            android:textColor="#E2DEDE" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewRitmo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_tight_medium"
                            android:text="Ritmo"
                            android:textColor="#E2DEDE" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewDescripción"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_tight_medium"
                            android:text="Descripción"
                            android:textColor="#E2DEDE" />
                    </LinearLayout>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewHomeResultados"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingVertical="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>