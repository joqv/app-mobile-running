<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#100F0F"
    android:fitsSystemWindows="true"
    tools:context=".MainActivityPrincipal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageViewPrincipalWing"
            android:layout_width="245dp"
            android:layout_height="315dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/pngwing" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Running App"
            android:textAlignment="center"
            android:textColor="#D7D7D7"
            android:textSize="44sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonAccederPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#4CAF50"
            android:text="Acceder" />

        <Button
            android:id="@+id/buttonDesarrolloJose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="Boton (Desarrollo Jose)" />

        <Button
            android:id="@+id/buttonDesarrolloOmar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="Boton (Desarrollo Omar)" />

        <Button
            android:id="@+id/buttonDesarrolloJulio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="Boton (Desarrollo Julio)" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>